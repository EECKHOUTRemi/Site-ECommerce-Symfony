{% extends 'base.html.twig' %}

{% block title %}Cart{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">🛒 Your Cart</h1>
        {% if cart.racquets.count > 0 %}
            {{ form_start(formCart) }}
            <div class="row">
                <!-- List of items -->
                <div class="col-md-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h2 class="h5 mb-0">🎾 Racquets</h2>
                            <div>
                                <button id='clear' class='btn btn-light btn-sm ml-2'>Clear</button>
                            </div>
                        </div>
                        <ul class="list-group list-group-flush">
                            {% for item in formCart.racquets %}
                                <li class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <img src={{ asset('img/racquet/' ~ item.vars.data.racquet.id ~ '.' ~ item.vars.data.racquet.imgExtension) }} width="64" alt="Product image">
                                        </div>
                                        <div class="col">
                                            <h5 class="mb-1">
                                                <a href={{ path("racquet_detail", {'id': item.vars.data.racquet.id}) }}>
                                                    {{ item.vars.data.racquet.brand ~ ' ' ~ item.vars.data.racquet.model }}
                                                </a>
                                            </h5>
                                            <div class="form-inline mt-2">
                                                <div class="form-group mb-0 mr-2">
                                                Quantity :
                                                    {{ form_widget(item.quantity, {
                                                        'attr': {
                                                            'class': 'form-control form-control-sm ' ~ (item.quantity.vars.valid ? '' : 'is-invalid'),
                                                            'style': 'width: 80px;'
                                                        }
                                                    }) }}
                                                    <div class="invalid-feedback">
                                                        {{ form_errors(item.quantity) }}
                                                    </div>
                                                </div>
                                                {{ form_widget(item.remove, {'attr': {'class': 'btn btn-outline-danger btn-sm'}}) }}
                                            </div>
                                        </div>
                                        <div class="col-auto text-right">
                                            <strong class="text-primary">{{ item.vars.data.racquet.price }} €</strong>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {{ form_rest(formCart) }}
                    {{ form_end(formCart, {'render_rest': false}) }}
                </div>

                <!-- Summary -->
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h2 class="h5 mb-0">📊 Summary</h2>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <div class="mb-2">
                                    <strong class="d-block mb-2">🎟️ Promo Code</strong>
                                    {{ form_start(formPromo, {'attr': {'class': 'needs-validation'}}) }}
                                    <div class="input-group">
                                        {{ form_widget(formPromo.name, {'attr': {'class': 'form-control', 'placeholder': 'Enter code'}}) }}
                                        <div class="input-group-append">
                                            {{ form_widget(formPromo.submit, {'attr': {'class': 'btn btn-outline-secondary'}, 'label': 'Apply'}) }}
                                        </div>
                                    </div>
                                    {{ form_end(formPromo) }}
                                </div>
                                {% if cart.promoCode is not null %}
                                    <div class="alert alert-success p-2 mb-0 mt-2">
                                        <small class="d-block">
                                            <strong>✓ Code applied:</strong> {{ cart.promoCode.name }}
                                        </small>
                                        <small>
                                            <strong>Discount:</strong> <span class="badge bg-success text-white">{{ cart.promoCode.discount }}%</span>
                                        </small>
                                    </div>
                                {% endif %}
                            </li>
                            {% if cart.promoCode is not null %}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">Subtotal</span>
                                    <span class="text-muted">{{ cart.totalWithoutDiscount|number_format(2, '.', ',') }} €</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-success">Discount ({{ cart.promoCode.discount }}%)</span>
                                    <span class="text-success">-{{ (cart.totalWithoutDiscount - cart.total)|number_format(2, '.', ',') }} €</span>
                                </li>
                            {% endif %}
                            <li class="list-group-item d-flex justify-content-between">
                                <strong class="h5 mb-0">Total</strong>
                                <strong class="text-primary h5 mb-0">{{ cart.total|number_format(2, '.', ',') }} €</strong>
                            </li>
                        </ul>
                        <div class="card-body">
                            <a href= {{ path("app_cart_checkout") }} class="btn btn-success w-100">💳 Checkout</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                Your cart is empty. Go to the <a href="{{ path('racquets') }}" class="alert-link">product list</a>.
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block script %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle clear cart button
            const clearButton = document.querySelector('button[id*="clear"]');

            if (clearButton) {
                clearButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    if (confirm('Are you sure you want to clear your entire cart?')) {
                        // Create a form and submit to the clear endpoint
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '{{ path('app_cart_clear') }}';
                        
                        // Add CSRF token from the main form
                        const csrfToken = document.querySelector('input[name="cart[_token]"]');
                        if (csrfToken) {
                            const tokenInput = document.createElement('input');
                            tokenInput.type = 'hidden';
                            tokenInput.name = '_token';
                            tokenInput.value = csrfToken.value;
                            form.appendChild(tokenInput);
                        }
                        
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            }

            const quantityInputs = document.querySelectorAll('input[type="number"][id*="quantity"]');
            let timeoutId;
            
            quantityInputs.forEach(function(input) {
                input.addEventListener('change', function() {
                    clearTimeout(timeoutId);
                    
                    // Only submit if the value is valid
                    if (input.value && parseInt(input.value) > 0) {
                        timeoutId = setTimeout(function() {
                            input.closest('form').submit();
                        }, 500);
                    }
                });
            });
        });
    </script>
{% endblock %}