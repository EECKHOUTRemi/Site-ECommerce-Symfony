{% extends 'base.html.twig' %}

{% block title %}PromoCode Details
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="row">
			<div class="col-md-8 offset-md-2">
				<div class="card shadow-sm">
					<div class="card-header bg-primary text-white">
						<h1 class="h3 mb-0">👁️ Promo Code Details</h1>
					</div>
					<div class="card-body">
						<table class="table table-hover table-striped">
							<tbody>
								<tr>
									<th class="w-25">Id</th>
									<td>{{ promo_code.id }}</td>
								</tr>
								<tr>
									<th>Code Name</th>
									<td>
										<strong>{{ promo_code.name }}</strong>
									</td>
								</tr>
								<tr>
									<th>Discount</th>
									<td>
										<span class="badge bg-success fs-6">{{ promo_code.discount }}%</span>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
					<div class="card-footer d-flex justify-content-between align-items-center">
						<a href="{{ path('app_promo_code_index') }}" class="btn btn-secondary">
							Back to List
						</a>
						<div>
							<a href="{{ path('app_promo_code_edit', {'id': promo_code.id}) }}" class="btn btn-warning me-2">
								Edit
							</a>
							{{ include('admin/admin_promo_code/_delete_form.html.twig') }}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
