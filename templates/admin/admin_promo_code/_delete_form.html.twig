<form method="post" action="{{ path('app_promo_code_delete', {'id': promo_code.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline;">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ promo_code.id) }}">
	<button class="btn btn-danger">
		Delete</button>
</form>
