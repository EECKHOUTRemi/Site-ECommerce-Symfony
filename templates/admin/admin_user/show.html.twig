{% extends 'base.html.twig' %}

{% block title %}User Details
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="card shadow-sm">
			<div class="card-header bg-primary text-white">
				<h4 class="mb-0">
					User Details</h4>
			</div>
			<div class="card-body">
				<table class="table table-bordered">
					<tbody>
						<tr>
							<th class="bg-light" style="width: 200px;">Id</th>
							<td>{{ user.id }}</td>
						</tr>
						<tr>
							<th class="bg-light">Username</th>
							<td>
								<strong>{{ user.username }}</strong>
							</td>
						</tr>
						<tr>
							<th class="bg-light">Roles</th>
							<td>
								{% for role in user.roles %}
									<span class="badge bg-secondary me-1">{{ role }}</span>
								{% endfor %}
							</td>
						</tr>
						<tr>
							<th class="bg-light">Lastname</th>
							<td>{{ user.lastname }}</td>
						</tr>
						<tr>
							<th class="bg-light">Firstname</th>
							<td>{{ user.firstname }}</td>
						</tr>
						<tr>
							<th class="bg-light">Phone</th>
							<td>{{ user.phone }}</td>
						</tr>
						<tr>
							<th class="bg-light">Email</th>
							<td>
								<a href="mailto:{{ user.email }}">{{ user.email }}</a>
							</td>
						</tr>
					</tbody>
				</table>

				<div class="row mt-4">
					<!-- Orders Section -->
					<div class="col-md-6">
						<h5 class="mb-3">
							Orders ({{ orders|length }})
						</h5>
						{% if orders is empty %}
							<div class="alert alert-info">
								No orders yet.
							</div>
						{% else %}
							<div class="table-responsive">
								<table class="table table-striped table-hover table-bordered">
									<thead class="table-dark">
										<tr>
											<th>ID</th>
											<th>Status</th>
											<th>Created</th>
											<th>Updated</th>
										</tr>
									</thead>
									<tbody>
										{% for order in orders %}
											<tr>
												<td>#{{ order.id }}</td>
												<td>
													{% if order.status == 'cart' %}
														<span class="badge bg-secondary">{{ order.status|upper }}</span>
													{% elseif order.status == 'pending' %}
														<span class="badge bg-warning text-dark">{{ order.status|upper }}</span>
													{% elseif order.status == 'confirmed' %}
														<span class="badge bg-info">{{ order.status|upper }}</span>
													{% elseif order.status == 'shipped' %}
														<span class="badge bg-primary">{{ order.status|upper }}</span>
													{% elseif order.status == 'delivered' %}
														<span class="badge bg-success">{{ order.status|upper }}</span>
													{% elseif order.status == 'cancelled' %}
														<span class="badge bg-danger">{{ order.status|upper }}</span>
													{% else %}
														<span class="badge bg-secondary">{{ order.status|upper }}</span>
													{% endif %}
												</td>
												<td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
												<td>{{ order.updatedAt|date('Y-m-d H:i') }}</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% endif %}
					</div>

					<!-- Ratings Section -->
					<div class="col-md-6">
						<h5 class="mb-3">
							Ratings ({{ ratings|length }})
						</h5>
						{% if ratings is empty %}
							<div class="alert alert-info">
								No ratings yet.
							</div>
						{% else %}
							<div class="table-responsive">
								<table class="table table-striped table-hover table-bordered">
									<thead class="table-dark">
										<tr>
											<th>ID</th>
											<th>Racquet</th>
											<th>Rating</th>
										</tr>
									</thead>
									<tbody>
										{% for rating in ratings %}
											<tr>
												<td>#{{ rating.id }}</td>
												<td>{{ rating.racquet.brand ~ " " ~ rating.racquet.model }}</td>
												<td>
													<div class="d-flex align-items-center">
														<span class="ms-2 badge 
														{% if rating.rating >= 7 %}
															bg-success
														{% elseif rating.rating >= 3 %}
															bg-warning text-dark
														{% else %}
															bg-danger
														{% endif %}
														">{{ rating.rating }}/10</span>
													</div>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
			<div class="card-footer bg-light">
				<div class="d-flex justify-content-between align-items-center">
					<a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">
						Back to list
					</a>
					<div>
						<a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-warning me-2">
							Edit
						</a>
						{{ include('admin/admin_user/_delete_form.html.twig') }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
