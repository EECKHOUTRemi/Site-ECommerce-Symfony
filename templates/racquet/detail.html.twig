{% extends 'base.html.twig' %}

{% block title %}{{ racquet.brand }} {{ racquet.model }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h1 class="h3 mb-0">{{ racquet.brand }} {{ racquet.model }}</h1>
                            <div class="rating-display">
                                <!-- if racquet.avgRating, rating = racquet.avgRating else rating = null -->
                                {% set rating = racquet.avgRating  ? racquet.avgRating : null %} 
                                <!-- if rating, ratingText = racquet.avgRating + "/10" else ratingText = "No rating for now" -->
                                {% set ratingText = rating ? racquet.avgRating ~ "/10" : "No rating for now" %} 
                                <span class="ms-2 badge 
                                    {% if rating %}
                                        {% if rating < 3 %}
                                            bg-danger
                                        {% elseif rating < 6 %}
                                            bg-warning
                                        {% elseif rating < 8 %}
                                            bg-info
                                        {% else %}
                                            bg-success
                                        {% endif %}
                                    {% else %}
                                        bg-light text-dark
                                    {% endif %}
                                ">{{ ratingText }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center mb-3">
                            {% set imgPath = 'img/racquet/' ~ racquet.id ~ '.' ~ racquet.imgExtension %}
                                <img 
                                src="{{ asset(file_exists(imgPath) ? imgPath : 'img/placeholder/racquet.png') }}" 
                                alt="{{ racquet.brand }} {{ racquet.model }}" 
                                class="img-thumbnail" 
                                style="max-width: 100%;"
                                >
                            </div>
                            <div class="col-md-8">
                                <h2 class="text-primary mb-4">{{ racquet.price }} €</h2>
                                
                                <div class="mb-4">
                                    <span class="badge 
                                    {% if racquet.quantity >= 30 %}
                                        bg-success
                                    {% elseif racquet.quantity >= 10 %}
                                        bg-warning text-dark
                                    {% else %}
                                        bg-danger
                                    {% endif %}
                                    fs-6">
                                        <i class="bi bi-box-seam"></i>
                                        {{ racquet.quantity }} in stock
                                    </span>
                                </div>

                                {{ form_start(cartForm) }}
                                
                                <div class="card border-0 bg-light mb-4">
                                    <div class="card-body">
                                        <h5 class="card-title mb-3">
                                            Customize Your Racquet
                                        </h5>
                                        
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small">
                                                    Weight
                                                </label>
                                                {{ form_widget(cartForm.weight, {'attr': {'class': 'form-select form-select-sm'}}) }}
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small">
                                                    Head Size
                                                </label>
                                                {{ form_widget(cartForm.head_size, {'attr': {'class': 'form-select form-select-sm'}}) }}
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small">
                                                    String Pattern
                                                </label>
                                                {{ form_widget(cartForm.string_pattern, {'attr': {'class': 'form-select form-select-sm'}}) }}
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small">
                                                    Grip Size
                                                </label>
                                                {{ form_widget(cartForm.grip_size, {'attr': {'class': 'form-select form-select-sm'}}) }}
                                            </div>
                                        </div>
                                        
                                        <hr>
                                        
                                        <div class="row g-2 align-items-end">
                                            <div class="col-auto">
                                                <label class="form-label fw-bold small mb-1">
                                                    {{ form_label(cartForm.quantity, 'Quantity') }}
                                                </label>
                                                {{ form_widget(cartForm.quantity, {
                                                    'attr': {
                                                        'class': 'form-control form-control-sm ' ~ (cartForm.quantity.vars.valid ? '' : 'is-invalid'),
                                                        'min': '1',
                                                        'max': racquet.quantity,
                                                        'style': 'width: 80px;'
                                                    }
                                                }) }}
                                                <div class="invalid-feedback">
                                                    {{ form_errors(cartForm.quantity) }}
                                                </div>
                                            </div>
                                            <div class="col-auto ms-2">
                                                {{ form_widget(cartForm.add, {'attr': {'class': 'btn btn-success'}}) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{ form_end(cartForm) }}

                                <div class="alert alert-light border py-2 mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="small" style="white-space: nowrap;">
                                            Rate:
                                        </span>
                                        {{ form_start(ratingForm) }}
                                        <div class="d-flex gap-3">
                                            {{ form_widget(ratingForm.rating, {
                                                'attr': {
                                                    'class': 'form-control form-control-sm',
                                                    'placeholder': '0-10',
                                                    'style': 'width: 70px;'
                                                }
                                            }) }}
                                            {{ form_widget(ratingForm.submit, {'label': 'Submit', 'attr': {'class': 'btn btn-sm btn-outline-primary'}}) }}
                                        </div>
                                        {{ form_end(ratingForm) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="{{ path('racquets') }}" class="btn btn-secondary">
                            Back to Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}